{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force *",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*id_rsa*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
